#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUITE_CLI_DIR="$SCRIPT_DIR/.ai-suite/cli"
if [[ ! -d "$SUITE_CLI_DIR" ]]; then
  if [[ -d "$SCRIPT_DIR/cli" ]]; then
    SUITE_CLI_DIR="$SCRIPT_DIR/cli"
  elif [[ -d "$SCRIPT_DIR/../cli" ]]; then
    SUITE_CLI_DIR="$SCRIPT_DIR/../cli"
  fi
fi

usage() {
  cat <<'HELP'
AI Suite CLI - Universal Self-Evolving Agent Framework

USAGE:
  ai-suite <command> [options]

COMMANDS:
  enable      Enable the AI suite for a specific agent
  disable     Disable the AI suite
  evolve      Collect or push evolutions
  workflow    Run workflow commands (absorb, integrate, etc.)
  manage      Manage domain skills
  publish     Publish the AI suite package
HELP
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

CMD="$1"
shift

case "$CMD" in
  -h|--help|help)
    usage
    exit 0
    ;;
  enable)
    "$SUITE_CLI_DIR/enable.sh" "$@"
    ;;
  disable)
    "$SUITE_CLI_DIR/disable.sh" "$@"
    ;;
  evolve)
    "$SUITE_CLI_DIR/evolve.sh" "$@"
    ;;
  workflow)
    "$SUITE_CLI_DIR/workflow.sh" "$@"
    ;;
  manage)
    "$SUITE_CLI_DIR/manage.sh" "$@"
    ;;
  publish)
    "$SUITE_CLI_DIR/publish.sh" "$@"
    ;;
  *)
    echo "Unknown command: $CMD"
    usage
    exit 1
    ;;
esac
